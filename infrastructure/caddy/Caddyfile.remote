:80 {
    handle /api/* {
        reverse_proxy backend:8080
    }

    handle /t/* {
        reverse_proxy backend:8080
    }

    handle /landing/* {
        reverse_proxy backend:8080
    }

    handle /training/* {
        reverse_proxy backend:8080
    }

    handle /actuator/health {
        reverse_proxy backend:8080
    }

    handle {
        reverse_proxy frontend:80
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}
