# Copy to .env.remote and replace every CHANGE_ME value.
DB_NAME=phishing_awareness
DB_USERNAME=phishing_app
DB_PASSWORD=CHANGE_ME_database_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password

SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=CHANGE_ME_long_random_jwt_secret

# Leave empty for CRUD/tracking-only validation. Set the GoPhish API key
# before testing campaign launch.
GOPHISH_API_KEY=
GOPHISH_URL=http://SERVER_IP_OR_DOMAIN:8081
PAWARE_PUBLIC_URL=http://SERVER_IP_OR_DOMAIN

GOPHISH_RESULTS_POLL_DELAY_MS=30000
GOPHISH_FROM_ADDRESS=avisos@jovycandy.com
SMTP_HOST=relay
SMTP_PORT=25

# Relay SMTP (boky/postfix) -> Gmail/Google Workspace de jovycandy.com
RELAY_HOST=smtp.gmail.com:587
RELAY_USER=CHANGE_ME@jovycandy.com
RELAY_PASS=CHANGE_ME_app_password
